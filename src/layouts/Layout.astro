---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
  /** Anton is the poster face, and `/` is the only route that sets it — the
   *  hero when signed out, the stat numerals when signed in. Every other screen
   *  would be shipping a single-weight display font it never uses. (It was the
   *  wordmark for one revision, which is why this flag briefly went away.) */
  poster?: boolean;
}

const { title = "about-books", poster = false } = Astro.props;

const families = ["Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700", "IBM+Plex+Mono:wght@400;500;600"];
if (poster) families.unshift("Anton");

const fontHref = `https://fonts.googleapis.com/css2?${families.map((f) => `family=${f}`).join("&")}&display=swap`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- initial-scale was missing before this change, which is why pages could
         render zoomed on some phones. viewport-fit=cover is the precondition
         for the safe-area padding the shell relies on. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontHref} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Heads up:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Documentation"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
    <script>
      /* Every form in this app is a plain POST that answers with a redirect, so between the tap
         and the next page nothing on screen changed -- readers pressed Save, saw nothing, and
         pressed it again. This marks the button that submitted as busy (button.tsx draws the
         spinner) and swallows a second submit of the same form.

         A progressive enhancement: with scripting off, forms submit exactly as they did.
         `aria-busy` rather than `disabled`, because a disabled submitter is left out of the
         submission. The React SubmitButton relied on useFormStatus, which only tracks React
         form actions -- with a URL `action` it never reported pending, so it is covered here too. */
      document.addEventListener("submit", (event) => {
        // A client-side validation failure (the React forms) already cancelled this submit.
        if (event.defaultPrevented || !(event.target instanceof HTMLFormElement)) return;
        const form = event.target;

        if (form.dataset.pending !== undefined) {
          event.preventDefault();
          return;
        }
        form.dataset.pending = "";

        const button = event.submitter;
        if (!(button instanceof HTMLButtonElement)) return;
        button.setAttribute("aria-busy", "true");

        // Optional wording for the wait. Swapped only in a `[data-label]` element or a button
        // that holds nothing but text, so an icon is never overwritten.
        const pendingText = button.dataset.pendingText;
        const label =
          button.querySelector<HTMLElement>("[data-label]") ?? (button.childElementCount === 0 ? button : null);
        if (pendingText && label) {
          label.dataset.idleText = label.textContent ?? "";
          label.textContent = pendingText;
        }
      });

      // Back/forward restores the page from cache exactly as it was left: mid-submit. Undo it,
      // or the reader returns to a spinner that never finishes and a form that ignores them.
      window.addEventListener("pageshow", (event) => {
        if (!event.persisted) return;
        document.querySelectorAll<HTMLFormElement>("form[data-pending]").forEach((f) => delete f.dataset.pending);
        document.querySelectorAll('[aria-busy="true"]').forEach((b) => b.removeAttribute("aria-busy"));
        document.querySelectorAll<HTMLElement>("[data-idle-text]").forEach((l) => {
          l.textContent = l.dataset.idleText ?? "";
          delete l.dataset.idleText;
        });
      });

      // iOS Safari applies :active only on pages that listen for touches; without this the
      // pressed state in button.tsx never shows on an iPhone.
      document.addEventListener("touchstart", () => undefined, { passive: true });
    </script>
  </body>
</html>
