---
type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;
---

<div class:list={["banner", `banner--${variant}`]} role={variant === "error" ? "alert" : "status"}>
  <slot />
</div>

<style>
  /* The one place a third and fourth hue is justified — status semantics on a
   * misconfigured deploy. None of them appear in normal use, so the accent
   * budget is untouched. Both are held to the same L/C discipline as --accent. */
  .banner {
    padding: var(--space-xs) var(--space-md);
    font-family: var(--font-label);
    font-size: var(--text-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    text-align: center;
    border-block-end: var(--rule-w-mid) solid;
    background: var(--paper-2);
  }
  .banner :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .banner :global(strong) {
    font-weight: 600;
  }
  .banner--info {
    color: oklch(43% 0.1 250);
    border-color: oklch(43% 0.1 250);
  }
  .banner--warning {
    color: oklch(45% 0.1 75);
    border-color: oklch(45% 0.1 75);
  }
  .banner--error {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
