---
interface Props {
  /** When set the whole title becomes the link — one target, not a nested pair. */
  href?: string;
  title: string;
  /** Rendered in the label device: mono, uppercase, tracked. Short strings only. */
  meta?: (string | null | undefined)[];
  /** Meta that only earns its place when there is room. Hidden below 40rem —
   *  at 390px a third part tips the line into wrapping, and an uneven row
   *  height down a list costs more than the part was worth. */
  metaWide?: (string | null | undefined)[];
  note?: string | null;
  /** A named figure on its own line — label in the accent, value beside it.
   *  Anything in `meta` then moves to the right end of that same line. */
  stat?: { label: string; value: string } | null;
  dim?: boolean;
}

const { href, title, meta = [], metaWide = [], note, stat = null, dim = false } = Astro.props;
const metaParts = meta.filter((m): m is string => Boolean(m));
const wideParts = metaWide.filter((m): m is string => Boolean(m));
---

<li class:list={["row", { dim }]}>
  <div class="head">
    {
      href ? (
        <a class="title" href={href}>
          {title}
        </a>
      ) : (
        <p class="title">{title}</p>
      )
    }
    {
      !stat && (metaParts.length > 0 || wideParts.length > 0) && (
        <p class="meta label">
          {metaParts.join(" · ")}
          {wideParts.length > 0 && (
            <span class="wide">
              {metaParts.length > 0 ? " · " : ""}
              {wideParts.join(" · ")}
            </span>
          )}
        </p>
      )
    }
  </div>
  {note && <p class="note">{note}</p>}
  {
    stat && (
      <p class="stat">
        <span class="stat-k label">{stat.label}</span>
        <span class="stat-v">{stat.value}</span>
        {(metaParts.length > 0 || wideParts.length > 0) && (
          <span class="stat-meta label">
            {metaParts.join(" · ")}
            {wideParts.length > 0 && (
              <span class="wide">
                {metaParts.length > 0 ? " · " : ""}
                {wideParts.join(" · ")}
              </span>
            )}
          </span>
        )}
      </p>
    )
  }
  <slot />
</li>

<style>
  /* No radius, no background, no shadow, no box. The hairline is the whole
     visual language of every list in the product. */
  .row {
    position: relative;
    border-block-end: var(--rule-w) solid var(--rule);
    /* Asymmetric on purpose: 8 above, 6 below. The title needs a little air
       off the hairline it sits under; the meta line beneath it does not, and
       the 2px would cost a row of the list every dozen entries. */
    padding: 8px var(--space-md) 6px;
    min-height: var(--row-h);
    transition: background var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .row:hover {
      background: var(--paper-3);
    }
  }
  .row:active {
    background: var(--paper-3);
  }
  @media (prefers-reduced-motion: reduce) {
    .row {
      transition: none;
    }
  }

  /* Title on its own line, meta underneath — always, not only when the row is
     too narrow to hold both. Letting them share a line made the break point
     depend on how long the title happened to be, so the same list showed two
     different shapes down its length. */
  .head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    min-width: 0;
  }

  /* Same size as body copy: the FAMILY marks it as a title, not the size.
     That is why four type sizes are enough for the whole app. */
  .title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-base);
    line-height: 1.28;
    color: var(--ink);
    text-decoration: none;
    overflow-wrap: anywhere;
    min-width: 0;
  }
  a.title:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* The whole row is the target, not the 20px title. Two gains at once: a
     thumb no longer has to find a line of text, and the block padding can come
     down without dropping the hit area below the 44px floor. Anything
     interactive inside the row (a disclosure, a form) sits above this layer
     because it comes later in the DOM and this has no z-index of its own. */
  a.title::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .meta {
    margin: 0;
  }
  @media (max-width: 40rem) {
    .meta .wide {
      display: none;
    }
  }

  .note {
    margin: 1px 0 0;
    font-size: 0.9rem;
    line-height: 1.35;
    color: var(--ink-2);
    max-width: 62ch;
    overflow-wrap: anywhere;
  }

  /* The figure gets its own line: a label in the accent, the value beside it, and
     any meta pushed to the far end. Same device as the relationship types in the
     cast — a system word in the accent, the reader's content in ink. */
  .stat {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    margin: 1px 0 0;
    font-size: 0.9rem;
    color: var(--ink-2);
    min-width: 0;
  }
  .stat-k {
    color: var(--accent);
    flex: none;
  }
  .stat-v {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .stat-meta {
    margin-inline-start: auto;
    flex: none;
    text-align: end;
  }

  .dim .title,
  .dim .stat,
  .dim .note {
    color: var(--muted-fg);
  }
</style>
