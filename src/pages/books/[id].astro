---
import Layout from "@/layouts/Layout.astro";
import AddCharacterForm from "@/components/characters/AddCharacterForm";
import { createClient } from "@/lib/supabase";
import type { Book, Character, Relationship, RelationshipTypeRow } from "@/types";
import { RELATIONSHIP_TYPES } from "@/types";
import { buildConnections } from "@/lib/connections";
import { Users } from "lucide-react";

type BookRow = Pick<Book, "id" | "title" | "author" | "finished_at">;
type CharacterRow = Pick<Character, "id" | "name" | "description" | "created_at">;
type RelationshipRow = Pick<Relationship, "id" | "character_a_id" | "character_b_id" | "type" | "custom_type_id">;
type RelationshipTypeOption = Pick<RelationshipTypeRow, "id" | "name">;

const bookId = Astro.params.id;
const formError = Astro.url.searchParams.get("error");

const supabase = createClient(Astro.request.headers, Astro.cookies);

let book: BookRow | null = null;
let characters: CharacterRow[] = [];
let loadError: string | null = null;

if (!supabase) {
  loadError = "Supabase is not configured";
} else {
  // RLS-filtered: another reader's book id is indistinguishable from a missing one, which is
  // the behaviour we want — a 404 leaks nothing about what other readers have.
  const { data: found } = await supabase
    .from("books")
    .select("id, title, author, finished_at")
    .eq("id", bookId)
    .maybeSingle<BookRow>();
  book = found;

  if (book) {
    const { data, error } = await supabase
      .from("characters")
      .select("id, name, description, created_at")
      .eq("book_id", bookId)
      .order("created_at", { ascending: false });

    if (error) {
      loadError = error.message;
    } else {
      characters = data;
    }
  }
}

// A top-level `return` in Astro frontmatter crashes @typescript-eslint/no-misused-promises
// ("Expected node to have a parent"), so the status is set on Astro.response instead. Same
// result — a real 404 — with no early return and no rule suppression.
const dateFormatter = new Intl.DateTimeFormat("en-GB", { dateStyle: "medium" });

// The types this reader coined for THIS book. Loaded once and passed to buildConnections,
// which resolves each connection's label from whichever source it carries. A second query
// plus a Map, mirroring how character names are resolved — no embedded select, so the
// `.or()` below stays exactly as it was.
let customTypes: RelationshipTypeOption[] = [];

if (supabase && book) {
  const { data, error: typesError } = await supabase
    .from("relationship_types")
    .select("id, name")
    .eq("book_id", bookId)
    .order("name")
    .overrideTypes<RelationshipTypeOption[], { merge: false }>();

  if (typesError) {
    loadError ??= typesError.message;
  } else {
    customTypes = data;
  }
}

let connectionsByCharacter = new Map<
  string,
  ReturnType<typeof buildConnections> extends Map<string, infer C> ? C : never
>();

if (supabase && characters.length > 0) {
  // Relationships touching this cast. The lookup matches either end, so `.or()` spans both
  // columns; the cast's ids already bound it to this book, which is why the table needs no
  // book_id of its own.
  const ids = characters.map((c) => c.id).join(",");

  const { data: rels, error: relError } = await supabase
    .from("relationships")
    .select("id, character_a_id, character_b_id, type, custom_type_id")
    .or(`character_a_id.in.(${ids}),character_b_id.in.(${ids})`)
    .overrideTypes<RelationshipRow[], { merge: false }>();

  if (relError) {
    loadError ??= relError.message;
  } else {
    // Undirected indexing and the two-source label resolution both live in
    // src/lib/connections.ts, where they are covered by unit tests. Nothing about them can
    // be checked from here: page frontmatter is unreachable by any command.
    connectionsByCharacter = buildConnections(characters, rels, customTypes);
  }
}

// Precomputed so the template stays a plain map: each row carries its own connections and
// the other cast members it can be related to.
const castRows = characters.map((character) => ({
  character,
  connections: connectionsByCharacter.get(character.id) ?? [],
  others: characters.filter((c) => c.id !== character.id),
}));

if (!book && !loadError) {
  Astro.response.status = 404;
}
---

<Layout title={book?.title ?? "Book not found"}>
  <div class="bg-cosmic min-h-screen px-4 py-10">
    <div class="mx-auto w-full max-w-2xl space-y-8">
      {
        !book && (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
            <p class="text-lg font-semibold">Book not found</p>
            <p class="mt-2 text-sm text-blue-100/60">
              {loadError ?? "It may have been deleted, or it belongs to another reader."}
            </p>
            <a href="/books" class="mt-4 inline-block text-sm text-purple-300 hover:underline">
              &larr; Back to your books
            </a>
          </div>
        )
      }

      {
        book && (
          <>
            <header>
              <a href="/books" class="text-sm text-purple-300 hover:underline">
                &larr; All books
              </a>
              <h1 class="mt-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold break-words text-transparent">
                {book.title}
              </h1>
              <p class="mt-1 text-sm break-words text-blue-100/60">{book.author ?? "Author unknown"}</p>

              {book.finished_at && (
                <p class="mt-2 text-xs text-blue-100/50">Finished {dateFormatter.format(new Date(book.finished_at))}</p>
              )}

              {/* The form submits the state it WANTS, not "flip whatever it is now" -- submitting
                  twice is therefore idempotent, which a double tap on a slow connection needs. */}
              <form method="POST" action={`/api/books/${book.id}/finish`} class="mt-3">
                <input type="hidden" name="finished" value={book.finished_at ? "false" : "true"} />
                <button
                  type="submit"
                  class="rounded-lg border border-white/20 bg-white/10 px-3 py-1.5 text-sm transition-colors hover:bg-white/20"
                >
                  {book.finished_at ? "Reopen this book" : "Mark as finished"}
                </button>
              </form>
            </header>

            <section class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
              <h2 class="mb-4 text-lg font-semibold">Add a character</h2>
              <AddCharacterForm bookId={book.id} serverError={formError} client:load />
            </section>

            <section class="space-y-3">
              <h2 class="text-lg font-semibold text-white">
                Cast
                {characters.length > 0 && <span class="text-blue-100/50">({characters.length})</span>}
              </h2>

              {loadError && (
                <p class="rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">
                  {loadError}
                </p>
              )}

              {!loadError && characters.length === 0 && (
                <div class="rounded-2xl border border-white/10 bg-white/5 p-8 text-center text-blue-100/60 backdrop-blur-xl">
                  <Users className="mx-auto mb-3 size-8 text-white/30" />
                  <p>No characters yet. Add the first name you meet.</p>
                </div>
              )}

              <ul class="space-y-3">
                {castRows.map(({ character, connections, others }) => (
                  <li class="rounded-2xl border border-white/10 bg-white/10 p-4 text-white backdrop-blur-xl">
                    <p class="font-medium break-words">{character.name}</p>
                    {character.description && (
                      <p class="mt-1 text-sm break-words text-blue-100/70">{character.description}</p>
                    )}

                    {/* No heading, ever: a character with no relationships renders nothing here at all.
                        That is the state the cast view is in before any relationship exists -- the first
                        thing a reader ever sees -- and an empty heading under every name would make a
                        working page look broken. */}
                    {connections.length > 0 && (
                      <ul class="mt-2 space-y-0.5">
                        {connections.map((connection) => (
                          <li class="text-sm">
                            <span class="text-purple-300">{connection.typeLabel}</span>
                            <span class="text-blue-100/40"> &middot; </span>
                            <span class="break-words text-blue-100/80">{connection.otherName}</span>
                          </li>
                        ))}
                      </ul>
                    )}

                    {/* Native <details> disclosure: no island and no client JavaScript, so edit and
                        delete keep working with scripting disabled. */}
                    <details class="mt-3">
                      <summary class="cursor-pointer text-xs text-purple-300 hover:underline">Edit or delete</summary>

                      <form method="POST" action={`/api/characters/${character.id}`} class="mt-3 space-y-2">
                        <input type="hidden" name="book_id" value={book.id} />
                        <label class="block text-xs text-blue-100/70" for={`name-${character.id}`}>
                          Name
                        </label>
                        <input
                          id={`name-${character.id}`}
                          name="name"
                          value={character.name}
                          class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white focus:ring-2 focus:ring-purple-400 focus:outline-none"
                        />
                        <label class="block text-xs text-blue-100/70" for={`desc-${character.id}`}>
                          Note
                        </label>
                        <input
                          id={`desc-${character.id}`}
                          name="description"
                          value={character.description ?? ""}
                          placeholder="Add a note as you read"
                          class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white placeholder-white/40 focus:ring-2 focus:ring-purple-400 focus:outline-none"
                        />
                        <button
                          type="submit"
                          class="rounded-lg bg-purple-600 px-3 py-1.5 text-sm font-medium transition-colors hover:bg-purple-500"
                        >
                          Save changes
                        </button>
                      </form>

                      {/* Confirmation as a nested <details>: the destructive button only exists once the
                          reader has opened it, so a mis-tap on the summary costs a click, not a character.
                          A JS confirm() would not survive scripting being off, and this page has no island. */}
                      <details class="mt-2">
                        <summary class="inline-block cursor-pointer list-none rounded-lg border border-red-400/40 px-3 py-1.5 text-sm text-red-300 transition-colors hover:bg-red-900/30 [&::-webkit-details-marker]:hidden">
                          Delete character
                        </summary>
                        <form
                          method="POST"
                          action={`/api/characters/${character.id}/delete`}
                          class="mt-2 rounded-lg border border-red-400/30 bg-red-950/30 p-3"
                        >
                          <p class="text-xs break-words text-blue-100/80">
                            Delete <span class="font-medium text-white">{character.name}</span> and every relationship
                            it appears in? This cannot be undone.
                          </p>
                          <button
                            type="submit"
                            class="mt-2 rounded-lg bg-red-600 px-3 py-1.5 text-sm font-medium text-white transition-colors hover:bg-red-500"
                          >
                            Yes, delete permanently
                          </button>
                        </form>
                      </details>

                      {others.length > 0 ? (
                        <form
                          method="POST"
                          action={`/api/characters/${character.id}/relationships`}
                          class="mt-4 space-y-2 border-t border-white/10 pt-3"
                        >
                          <p class="text-xs text-blue-100/70">Add a relationship</p>
                          <select
                            name="other_character_id"
                            class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white focus:ring-2 focus:ring-purple-400 focus:outline-none"
                          >
                            {others.map((other) => (
                              <option value={other.id}>{other.name}</option>
                            ))}
                          </select>
                          {/* One field, two meanings: a shared literal or a custom type's id. <optgroup>
                              is native, so the merged list costs no JavaScript and the form still
                              works with scripting off. The endpoint decides the column by shape. */}
                          <select
                            name="type"
                            class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white focus:ring-2 focus:ring-purple-400 focus:outline-none"
                          >
                            <optgroup label="Shared">
                              {RELATIONSHIP_TYPES.map((relationshipType) => (
                                <option value={relationshipType}>{relationshipType}</option>
                              ))}
                            </optgroup>
                            {customTypes.length > 0 && (
                              <optgroup label="Your types for this book">
                                {customTypes.map((customType) => (
                                  <option value={customType.id}>{customType.name}</option>
                                ))}
                              </optgroup>
                            )}
                          </select>
                          <button
                            type="submit"
                            class="rounded-lg bg-purple-600 px-3 py-1.5 text-sm font-medium transition-colors hover:bg-purple-500"
                          >
                            Add relationship
                          </button>
                        </form>
                      ) : (
                        <p class="mt-4 border-t border-white/10 pt-3 text-xs text-blue-100/50">
                          Add another character to this book before creating a relationship.
                        </p>
                      )}

                      {/* Managing connections lives inside the disclosure on purpose: the always-visible list
                          above stays a clean scan, and edit/delete controls do not compete with it. */}
                      {connections.length > 0 && (
                        <div class="mt-4 space-y-3 border-t border-white/10 pt-3">
                          <p class="text-xs text-blue-100/70">Change or remove a relationship</p>
                          {connections.map((connection) => (
                            <div class="rounded-lg border border-white/10 bg-white/5 p-2">
                              <form method="POST" action={`/api/relationships/${connection.id}`} class="space-y-2">
                                {/* The anchor tells the route which end to keep; it re-reads the row to work
                                    out which column that is. */}
                                <input type="hidden" name="anchor_id" value={character.id} />
                                <select
                                  name="other_character_id"
                                  class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white focus:ring-2 focus:ring-purple-400 focus:outline-none"
                                >
                                  {others.map((other) => (
                                    <option value={other.id} selected={other.id === connection.otherId}>
                                      {other.name}
                                    </option>
                                  ))}
                                </select>
                                <select
                                  name="type"
                                  class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white focus:ring-2 focus:ring-purple-400 focus:outline-none"
                                >
                                  <optgroup label="Shared">
                                    {RELATIONSHIP_TYPES.map((relationshipType) => (
                                      <option
                                        value={relationshipType}
                                        selected={relationshipType === connection.typeValue}
                                      >
                                        {relationshipType}
                                      </option>
                                    ))}
                                  </optgroup>
                                  {customTypes.length > 0 && (
                                    <optgroup label="Your types for this book">
                                      {customTypes.map((customType) => (
                                        <option value={customType.id} selected={customType.id === connection.typeValue}>
                                          {customType.name}
                                        </option>
                                      ))}
                                    </optgroup>
                                  )}
                                </select>
                                <button
                                  type="submit"
                                  class="rounded-lg bg-purple-600 px-3 py-1.5 text-sm font-medium transition-colors hover:bg-purple-500"
                                >
                                  Save relationship
                                </button>
                              </form>
                              <details class="mt-2">
                                <summary class="inline-block cursor-pointer list-none rounded-lg border border-red-400/40 px-3 py-1.5 text-sm text-red-300 transition-colors hover:bg-red-900/30 [&::-webkit-details-marker]:hidden">
                                  Remove relationship
                                </summary>
                                <form
                                  method="POST"
                                  action={`/api/relationships/${connection.id}/delete`}
                                  class="mt-2 rounded-lg border border-red-400/30 bg-red-950/30 p-3"
                                >
                                  <p class="text-xs break-words text-blue-100/80">
                                    Remove the <span class="text-purple-300">{connection.typeLabel}</span> connection
                                    with <span class="font-medium text-white">{connection.otherName}</span>? Both
                                    characters stay; only the connection goes.
                                  </p>
                                  <button
                                    type="submit"
                                    class="mt-2 rounded-lg bg-red-600 px-3 py-1.5 text-sm font-medium text-white transition-colors hover:bg-red-500"
                                  >
                                    Yes, remove it
                                  </button>
                                </form>
                              </details>
                            </div>
                          ))}
                        </div>
                      )}
                    </details>
                  </li>
                ))}
              </ul>
            </section>

            {/* The vocabulary lives behind a disclosure, closed by default: a reader who is happy
                with the five shared types never opens it and sees the page they had before. It sits
                after the cast because reading the cast is the point of this screen and managing a
                word list is not. */}
            <details class="rounded-2xl border border-white/10 bg-white/5 text-white backdrop-blur-xl">
              <summary class="cursor-pointer px-6 py-4 text-sm text-purple-300 hover:underline">
                Relationship types
                {customTypes.length > 0 && <span class="text-blue-100/40"> ({customTypes.length} of your own)</span>}
              </summary>

              <div class="space-y-4 border-t border-white/10 px-6 py-4">
                <p class="text-xs text-blue-100/60">
                  Five types are shared by every book: {RELATIONSHIP_TYPES.join(", ")}. Add your own for connections
                  this book needs and others do not — "lives with", "serves".
                </p>

                {customTypes.length > 0 && (
                  <ul class="space-y-1 text-sm">
                    {customTypes.map((customType) => (
                      <li class="break-words text-blue-100/80">{customType.name}</li>
                    ))}
                  </ul>
                )}

                <form method="POST" action={`/api/books/${book.id}/relationship-types`} class="space-y-2">
                  <label class="block text-xs text-blue-100/70" for="relationship-type-name">
                    New type for this book
                  </label>
                  <input
                    id="relationship-type-name"
                    name="name"
                    placeholder="lives with"
                    maxlength="40"
                    class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white placeholder-white/40 focus:ring-2 focus:ring-purple-400 focus:outline-none"
                  />
                  <button
                    type="submit"
                    class="rounded-lg bg-purple-600 px-3 py-1.5 text-sm font-medium transition-colors hover:bg-purple-500"
                  >
                    Add type
                  </button>
                </form>
              </div>
            </details>
          </>
        )
      }
    </div>
  </div>
</Layout>
