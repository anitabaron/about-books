---
import AppLayout from "@/layouts/AppLayout.astro";
import Row from "@/components/ui/Row.astro";
import { Button } from "@/components/ui/button";
import { Check, Trash2 } from "lucide-react";
import AddCharacterForm from "@/components/characters/AddCharacterForm";
import { createClient } from "@/lib/supabase";
import type { Book, Character, Relationship, RelationshipTypeRow } from "@/types";
import { RELATIONSHIP_TYPES } from "@/types";
import { buildConnections } from "@/lib/connections";

type BookRow = Pick<Book, "id" | "title" | "author" | "finished_at">;
type CharacterRow = Pick<Character, "id" | "name" | "description" | "created_at">;
type RelationshipRow = Pick<Relationship, "id" | "character_a_id" | "character_b_id" | "type" | "custom_type_id">;
type RelationshipTypeOption = Pick<RelationshipTypeRow, "id" | "name">;

const bookId = Astro.params.id;
// `error` carries the message; `at` says which part of the page it belongs to. Without `at`
// every rejected write on this page surfaced inside the "Add a character" island at the very
// top — a fresh page load with every disclosure closed again, so the reader was thrown out of
// the section they were working in and shown a message about a row they could no longer see.
const formError = Astro.url.searchParams.get("error");
const errorAt = Astro.url.searchParams.get("at");
const addCharacterError = errorAt === null ? formError : null;
// A rename or delete failure carries `for`, so its sentence renders inside that type's own
// record, beside the button the reader pressed. Adding a type has no id to point at, so its
// message stays with the add form.
const relationshipTypeErrorFor = errorAt === "relationship-types" ? Astro.url.searchParams.get("for") : null;
const relationshipTypesError = errorAt === "relationship-types" && relationshipTypeErrorFor === null ? formError : null;
// `for` narrows a connection error to the one character whose form was rejected, so the other
// cast rows do not each repeat it.
const connectionsErrorFor = errorAt === "connections" ? Astro.url.searchParams.get("for") : null;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let book: BookRow | null = null;
let characters: CharacterRow[] = [];
let loadError: string | null = null;

if (!supabase) {
  loadError = "Supabase is not configured";
} else {
  // RLS-filtered: another reader's book id is indistinguishable from a missing one, which is
  // the behaviour we want — a 404 leaks nothing about what other readers have.
  const { data: found } = await supabase
    .from("books")
    .select("id, title, author, finished_at")
    .eq("id", bookId)
    .maybeSingle<BookRow>();
  book = found;

  if (book) {
    const { data, error } = await supabase
      .from("characters")
      .select("id, name, description, created_at")
      .eq("book_id", bookId)
      .order("created_at", { ascending: false });

    if (error) {
      loadError = error.message;
    } else {
      characters = data;
    }
  }
}

// A top-level `return` in Astro frontmatter crashes @typescript-eslint/no-misused-promises
// ("Expected node to have a parent"), so the status is set on Astro.response instead. Same
// result — a real 404 — with no early return and no rule suppression.
const dateFormatter = new Intl.DateTimeFormat("en-GB", { dateStyle: "medium" });

// The types this reader coined for THIS book. Loaded once and passed to buildConnections,
// which resolves each connection's label from whichever source it carries. A second query
// plus a Map, mirroring how character names are resolved — no embedded select, so the
// `.or()` below stays exactly as it was.
let customTypes: RelationshipTypeOption[] = [];

if (supabase && book) {
  const { data, error: typesError } = await supabase
    .from("relationship_types")
    .select("id, name")
    .eq("book_id", bookId)
    .order("name")
    .overrideTypes<RelationshipTypeOption[], { merge: false }>();

  if (typesError) {
    loadError ??= typesError.message;
  } else {
    customTypes = data;
  }
}

let connectionsByCharacter = new Map<
  string,
  ReturnType<typeof buildConnections> extends Map<string, infer C> ? C : never
>();

if (supabase && characters.length > 0) {
  // Relationships touching this cast. The lookup matches either end, so `.or()` spans both
  // columns; the cast's ids already bound it to this book, which is why the table needs no
  // book_id of its own.
  const ids = characters.map((c) => c.id).join(",");

  const { data: rels, error: relError } = await supabase
    .from("relationships")
    .select("id, character_a_id, character_b_id, type, custom_type_id")
    .or(`character_a_id.in.(${ids}),character_b_id.in.(${ids})`)
    .overrideTypes<RelationshipRow[], { merge: false }>();

  if (relError) {
    loadError ??= relError.message;
  } else {
    // Undirected indexing and the two-source label resolution both live in
    // src/lib/connections.ts, where they are covered by unit tests. Nothing about them can
    // be checked from here: page frontmatter is unreachable by any command.
    connectionsByCharacter = buildConnections(characters, rels, customTypes);
  }
}

// Precomputed so the template stays a plain map: each row carries its own connections and
// the other cast members it can be related to.
const castRows = characters.map((character) => ({
  character,
  connections: connectionsByCharacter.get(character.id) ?? [],
  others: characters.filter((c) => c.id !== character.id),
}));

if (!book && !loadError) {
  Astro.response.status = 404;
}
---

<AppLayout title={book?.title ?? "Book not found"} activeBookId={book?.id}>
  {
    !book && (
      <div class="pad notfound">
        <h1 class="page-title">Book not found</h1>
        <p class="note-text">{loadError ?? "It may have been deleted, or it belongs to another reader."}</p>
        <a class="back label" href="/books">
          &larr; Back to your books
        </a>
      </div>
    )
  }

  {
    book && (
      <>
        {/* The status control rides the breadcrumb line rather than sitting under
            the title as an outlined button. It is used once or twice in a book's
            whole life, and at button weight it drew more attention than the cast
            it sits above. A <div>, not the <p> this used to be: a <form> is flow
            content and cannot live inside a paragraph. */}
        <header class="pad">
          <div class="crumb label">
            <span class="trail">
              <a href="/books">Books</a> <span aria-hidden="true">/</span> <span>{book.title}</span>
            </span>
            {/* The form submits the state it WANTS, not "flip whatever it is now" -- submitting
                twice is therefore idempotent, which a double tap on a slow connection needs. */}
            <form method="POST" action={`/api/books/${book.id}/finish`}>
              <input type="hidden" name="finished" value={book.finished_at ? "false" : "true"} />
              <button type="submit" class="finish">
                {book.finished_at ? "Reopen" : "Mark finished"}
              </button>
            </form>
          </div>
          <h1 class="page-title">{book.title}</h1>
          <div class="bookmeta">
            <span class="label">{book.author ?? "Author unknown"}</span>
            {book.finished_at && <span class="label">Finished {dateFormatter.format(new Date(book.finished_at))}</span>}
          </div>
        </header>

        {/* Closed by default: mid-read a reader is at least as likely to be editing a
            description as adding a name, and an always-open form owned the top of the screen
            on every visit. Adding still costs one tap, which US-02's 30-second bar affords.

            `open` when there is an error to show -- otherwise a rejected name would land in
            a collapsed section. Server-rendered attribute, so no JavaScript decides it. */}
        <details class="disclose block-disclose" open={addCharacterError !== null}>
          <summary>Add a character</summary>
          <div class="disclose-body">
            <AddCharacterForm bookId={book.id} serverError={addCharacterError} client:load />
          </div>
        </details>

        <p class="sec-head">
          <span class="label">Cast</span>
          <span class="label">{characters.length}</span>
        </p>

        {loadError && <p class="error-text pad">{loadError}</p>}

        {!loadError && characters.length === 0 && (
          <p class="note-text empty">No characters yet. Add the first name you meet.</p>
        )}

        <ul class="list">
          {castRows.map(({ character, connections, others }) => (
            <Row title={character.name} note={character.description}>
              {/* No heading, ever: a character with no relationships renders nothing here at all.
                  That is the state the cast view is in before any relationship exists -- the first
                  thing a reader ever sees -- and an empty heading under every name would make a
                  working page look broken. */}
              {connections.length > 0 && (
                <ul class="conns">
                  {connections.map((connection) => (
                    <li>
                      <span class="conn-type label">{connection.typeLabel}</span>
                      <span class="conn-name">{connection.otherName}</span>
                    </li>
                  ))}
                </ul>
              )}

              {/* Native <details> disclosure: no island and no client JavaScript, so edit and
                  delete keep working with scripting disabled. */}
              <details class="disclose">
                <summary>Edit</summary>
                <div class="disclose-body">
                  {/* Both forms are empty shells: every control lives in the stack below and
                      reaches its form with `form=`. That is what lets Name, Note and Link read
                      as one block of fields with a single Save/Delete row underneath, even
                      though three different endpoints are involved. A <form> cannot nest
                      inside another, so this is the only way to interleave them. */}
                  <form method="POST" action={`/api/characters/${character.id}`} id={`edit-character-${character.id}`}>
                    <input type="hidden" name="book_id" value={book.id} />
                  </form>
                  {others.length > 0 && (
                    <form
                      method="POST"
                      action={`/api/characters/${character.id}/relationships`}
                      id={`character-${character.id}-relationships`}
                    />
                  )}

                  <div class="stack">
                    <div class="field">
                      <label for={`name-${character.id}`}>Name</label>
                      <input
                        id={`name-${character.id}`}
                        form={`edit-character-${character.id}`}
                        name="name"
                        value={character.name}
                      />
                    </div>
                    <div class="field">
                      <label for={`desc-${character.id}`}>Note</label>
                      <input
                        id={`desc-${character.id}`}
                        form={`edit-character-${character.id}`}
                        name="description"
                        value={character.description ?? ""}
                        placeholder="Add a note as you read"
                      />
                    </div>

                    {connectionsErrorFor === character.id && formError && <p class="error-text">{formError}</p>}

                    {others.length > 0 ? (
                      <div class="rel">
                        <label for={`newrel-who-${character.id}`}>Link</label>
                        <div class="rel-controls">
                          {/* Person before type: the reader picks who this is about, then what
                              it is. One field, two meanings -- a shared literal or a custom
                              type's id; <optgroup> is native, so the merged list costs no
                              JavaScript and the endpoint decides the column by shape. */}
                          <select
                            id={`newrel-who-${character.id}`}
                            form={`character-${character.id}-relationships`}
                            name="other_character_id"
                          >
                            {others.map((other) => (
                              <option value={other.id}>{other.name}</option>
                            ))}
                          </select>
                          <select
                            form={`character-${character.id}-relationships`}
                            name="type"
                            aria-label={`Relationship type for ${character.name}`}
                          >
                            <optgroup label="Shared">
                              {RELATIONSHIP_TYPES.map((relationshipType) => (
                                <option value={relationshipType}>{relationshipType}</option>
                              ))}
                            </optgroup>
                            {customTypes.length > 0 && (
                              <optgroup label="Your types for this book">
                                {customTypes.map((customType) => (
                                  <option value={customType.id}>{customType.name}</option>
                                ))}
                              </optgroup>
                            )}
                          </select>
                          <Button
                            type="submit"
                            form={`character-${character.id}-relationships`}
                            variant="outline"
                            size="sm"
                          >
                            Add
                          </Button>
                        </div>
                      </div>
                    ) : (
                      <p class="note-small">Add another character to this book before creating a relationship.</p>
                    )}
                  </div>

                  {/* Save left, Delete right, on the last line. The confirmation stays a nested
                      <details>: the destructive control only exists once the reader has opened
                      it, so a mis-tap costs a click, not a character. A JS confirm() would not
                      survive scripting being off. */}
                  <div class="edit-actions">
                    <Button type="submit" form={`edit-character-${character.id}`} size="sm">
                      Save
                    </Button>
                    <details class="confirm">
                      <summary>Delete</summary>
                      <form method="POST" action={`/api/characters/${character.id}/delete`} class="confirm-body">
                        <p>
                          Delete <strong>{character.name}</strong> and every relationship it appears in? This cannot be
                          undone.
                        </p>
                        <Button type="submit" variant="destructive" size="sm">
                          Yes, delete permanently
                        </Button>
                      </form>
                    </details>
                  </div>

                  {/* Managing connections lives inside the disclosure on purpose: the always-visible list
                      above stays a clean scan, and edit/delete controls do not compete with it. */}
                  {connections.length > 0 && (
                    <div class="sub">
                      <p class="sub-label label">Change or remove</p>
                      {connections.map((connection) => (
                        <div class="conn-edit">
                          {/* Controls live OUTSIDE this form and reach it with `form=`, so the
                              bin can share their row: a <form> cannot nest inside another, and
                              the delete needs its own. Same shape as the character row above.

                              The id carries BOTH ids, not just the connection's. A relationship
                              renders under both of its characters, so keying on the connection
                              alone put the same id in the document twice — and a duplicate id
                              silently associates both rows' controls with the first form, which
                              would submit the other end's anchor_id and rewrite the wrong end. */}
                          <form
                            method="POST"
                            action={`/api/relationships/${connection.id}`}
                            id={`edit-rel-${character.id}-${connection.id}`}
                          >
                            {/* The anchor tells the route which end to keep; it re-reads the row to work
                                out which column that is. */}
                            <input type="hidden" name="anchor_id" value={character.id} />
                          </form>
                          {/* One row, the same shape as the add form above: type, person,
                                button. Two stacked rows cost ~40px per connection and made an
                                edit look like a different kind of control from an add. */}
                          <div class="rel">
                            <label for={`rel-type-${character.id}-${connection.id}`}>Edit</label>
                            <div class="rel-controls">
                              <select
                                id={`rel-type-${character.id}-${connection.id}`}
                                name="type"
                                form={`edit-rel-${character.id}-${connection.id}`}
                                aria-label={`Relationship type with ${connection.otherName}`}
                              >
                                <optgroup label="Shared">
                                  {RELATIONSHIP_TYPES.map((relationshipType) => (
                                    <option
                                      value={relationshipType}
                                      selected={relationshipType === connection.typeValue}
                                    >
                                      {relationshipType}
                                    </option>
                                  ))}
                                </optgroup>
                                {customTypes.length > 0 && (
                                  <optgroup label="Your types for this book">
                                    {customTypes.map((customType) => (
                                      <option value={customType.id} selected={customType.id === connection.typeValue}>
                                        {customType.name}
                                      </option>
                                    ))}
                                  </optgroup>
                                )}
                              </select>
                              <select
                                name="other_character_id"
                                form={`edit-rel-${character.id}-${connection.id}`}
                                aria-label={`Character connected to ${character.name}`}
                              >
                                {others.map((other) => (
                                  <option value={other.id} selected={other.id === connection.otherId}>
                                    {other.name}
                                  </option>
                                ))}
                              </select>
                              {/* A glyph, not the black Save from the block above. Correcting an
                                    existing connection is a smaller act than saving the character,
                                    and two solid buttons in one disclosure read as two equally
                                    important commits. Paired with the bin beside it, both quiet. */}
                              <Button
                                type="submit"
                                form={`edit-rel-${character.id}-${connection.id}`}
                                variant="ghost"
                                size="sm"
                                aria-label={`Save the connection with ${connection.otherName}`}
                              >
                                <Check className="size-3.5" aria-hidden="true" />
                              </Button>
                              <details class="confirm icon">
                                <summary
                                  aria-label={`Remove the ${connection.typeLabel} connection with ${connection.otherName}`}
                                >
                                  <Trash2 className="size-3.5" aria-hidden="true" />
                                </summary>
                                <form
                                  method="POST"
                                  action={`/api/relationships/${connection.id}/delete`}
                                  class="confirm-body"
                                >
                                  <p>
                                    Remove the <strong>{connection.typeLabel}</strong> connection with{" "}
                                    <strong>{connection.otherName}</strong>? Both characters stay; only the connection
                                    goes.
                                  </p>
                                  <Button type="submit" variant="destructive" size="sm">
                                    Yes, remove it
                                  </Button>
                                </form>
                              </details>
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </details>
            </Row>
          ))}
        </ul>

        {/* The vocabulary lives behind a disclosure, closed by default: a reader who is happy
            with the five shared types never opens it and sees the page they had before. It sits
            after the cast because reading the cast is the point of this screen and managing a
            word list is not. */}
        <details class="disclose block-disclose vocab">
          <summary>
            Relationship types{customTypes.length > 0 && <span class="count">&nbsp;&middot; {customTypes.length}</span>}
          </summary>

          <div class="disclose-body">
            <p class="note-small">
              Five types are shared by every book: {RELATIONSHIP_TYPES.join(", ")}. Add your own for connections this
              book needs and others do not — “lives with”, “serves”.
            </p>

            {customTypes.length > 0 && (
              <ul class="list vocab-list">
                {customTypes.map((customType) => (
                  <li id={`relationship-type-${customType.id}`} class="vocab-item">
                    {/* Rename is the half that repairs a typo -- delete cannot, because the
                        foreign key refuses to remove a type a connection still points at.
                        One update to this row changes the name on every connection holding it. */}
                    <form
                      method="POST"
                      action={`/api/relationship-types/${customType.id}`}
                      id={`rename-type-${customType.id}`}
                      class="stack"
                    >
                      <div class="field">
                        <label for={`rename-${customType.id}`}>Name</label>
                        <input id={`rename-${customType.id}`} name="name" value={customType.name} maxlength="40" />
                      </div>
                    </form>

                    {relationshipTypeErrorFor === customType.id && formError && <p class="error-text">{formError}</p>}

                    {/* Same shape as the character row: renaming is what a reader actually
                        does here, deleting is rare, so they share a line and delete is a
                        glyph. Save reaches its form with `form=` because a <form> cannot
                        nest inside another <form>. */}
                    <div class="edit-actions">
                      <Button type="submit" form={`rename-type-${customType.id}`} size="sm">
                        Save name
                      </Button>
                      <details class="confirm icon">
                        <summary aria-label={`Delete the type ${customType.name}`}>
                          <Trash2 className="size-3.5" aria-hidden="true" />
                        </summary>
                        <form
                          method="POST"
                          action={`/api/relationship-types/${customType.id}/delete`}
                          class="confirm-body"
                        >
                          <p>
                            Delete <strong>{customType.name}</strong> from this book’s vocabulary? Connections using it
                            must be changed first.
                          </p>
                          <Button type="submit" variant="destructive" size="sm">
                            Yes, delete this type
                          </Button>
                        </form>
                      </details>
                    </div>
                  </li>
                ))}
              </ul>
            )}

            {relationshipTypesError && <p class="error-text">{relationshipTypesError}</p>}

            {/* The fragment target sits on content INSIDE the <details>, not on the element
                itself: browsers that expand a closed disclosure to reach a fragment then open
                it, and the rest simply scroll here. No JavaScript either way. */}
            <form
              method="POST"
              action={`/api/books/${book.id}/relationship-types`}
              id="relationship-types-add"
              class="stack"
            >
              <div class="field">
                <label for="relationship-type-name">New</label>
                <input id="relationship-type-name" name="name" placeholder="lives with" maxlength="40" />
              </div>
              <div class="edit-actions">
                <Button type="submit" variant="outline" size="sm">
                  Add type
                </Button>
              </div>
            </form>
          </div>
        </details>
      </>
    )
  }
</AppLayout>

<style>
  .page-title {
    font-size: var(--text-lg);
    line-height: 1.15;
    /* Separation from the breadcrumb above it, not a page-top offset — which
       is why /books does not get this: its title has nothing above it but the
       top bar. */
    margin-block-start: 3px;
  }
  @media (max-width: 40rem) {
    .page-title {
      font-size: var(--text-md);
    }
  }

  .notfound {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    align-items: flex-start;
  }
  .back {
    text-decoration: none;
    color: var(--accent);
  }
  .back:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .crumb {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    margin: 0 0 var(--space-2xs);
  }
  .trail {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* Same register as the breadcrumb beside it: mono caps at label size, quiet
     until touched. It is still a submit in its own form, so nothing about the
     behaviour changes with the weight. */
  .finish {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font: inherit;
    font-family: var(--font-label);
    color: var(--accent);
    white-space: nowrap;
    min-height: 34px;
  }
  @media (pointer: fine) {
    .finish {
      min-height: 0;
    }
  }
  .finish:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .crumb a {
    color: var(--accent);
    text-decoration: none;
  }
  .crumb a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .bookmeta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
    margin-block-start: var(--space-2xs);
  }

  /* A page-level disclosure reads as a band across the page, not as a row. */
  .block-disclose {
    border-block: var(--rule-w) solid var(--rule);
    margin-block: var(--space-xs);
    padding-inline: var(--space-md);
  }
  .block-disclose > summary {
    padding-block: var(--space-xs);
  }
  .block-disclose > .disclose-body {
    border-block-start: 0;
    padding-block-end: var(--space-md);
  }
  /* The cast list already ends in a hairline; a second rule 16px below it
     reads as an empty band rather than as a section break. */
  /* details.vocab, not .vocab: it must out-specify the .block-disclose
     border-block shorthand declared above it. The cast list already ends in a
     hairline, and a second rule 16px below it reads as an empty band. */
  details.vocab {
    border-block-start: 0;
    margin-block-start: 0;
  }
  .vocab .count {
    color: var(--muted-fg);
  }

  .empty {
    padding: var(--space-md);
  }

  /* Relationship types are the one always-visible place the accent appears on
     every viewport. min-width lines them into a column the eye can skip down. */
  .conns {
    list-style: none;
    margin: var(--space-2xs) 0 0;
    padding: 0;
  }
  /* One shared column for the whole list, sized by subgrid to the widest label
     actually present -- not to a fixed 7.2em guess.
     `min-width` was wrong because it is a floor: a label wider than it pushed
     the name right and names started at a different x on every row. A fixed
     column fixed that but overshot, leaving a gulf after short labels like
     "family". max-content on the <ul> plus subgrid on each row gives both:
     names align, and the gap is only as wide as this book's longest type. */
  .conns {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
  }
  .conns li {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    gap: var(--space-xs);
    align-items: baseline;
    line-height: 1.35;
  }
  .conn-type {
    color: var(--accent);
    overflow-wrap: anywhere;
    min-width: 0;
  }
  .conn-name {
    font-size: 0.9rem;
    color: var(--ink-2);
