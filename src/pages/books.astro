---
import AppLayout from "@/layouts/AppLayout.astro";
import Row from "@/components/ui/Row.astro";
import AddBookForm from "@/components/books/AddBookForm";
import { createClient } from "@/lib/supabase";
import type { Book } from "@/types";
import { castLabel } from "@/lib/library";

type BookRow = Pick<Book, "id" | "title" | "author" | "created_at" | "finished_at"> & {
  characters: { count: number }[];
};

const formError = Astro.url.searchParams.get("error");

// "Currently reading" is the default, because that is the shelf a reader opening the app is
// almost always looking at; the whole collection is one click away under "All". Anything
// unrecognised — including a nonsense value typed into the URL — falls back to that same
// default rather than an error page.
const STATUS_FILTERS = ["active", "finished", "all"] as const;
type StatusFilter = (typeof STATUS_FILTERS)[number];

const requestedStatus = Astro.url.searchParams.get("status");
const status: StatusFilter = STATUS_FILTERS.find((f) => f === requestedStatus) ?? "active";

const supabase = createClient(Astro.request.headers, Astro.cookies);

let books: BookRow[] = [];
let loadError: string | null = null;

if (supabase) {
  // RLS restricts this to the signed-in reader's own rows; no user_id filter is needed
  // here, and adding one would duplicate the policy rather than reinforce it.
  // `characters(count)` is a PostgREST embedded aggregate: cast sizes arrive with
  // the books, so a fifty-book library is still one round trip.
  const base = supabase.from("books").select("id, title, author, created_at, finished_at, characters(count)");

  // finished_at IS the status: null means currently reading, a timestamp means finished.
  const scoped =
    status === "active"
      ? base.is("finished_at", null)
      : status === "finished"
        ? base.not("finished_at", "is", null)
        : base;

  const { data, error } = await scoped.order("created_at", { ascending: false });

  if (error) {
    loadError = error.message;
  } else {
    // Supabase's response is a discriminated union: with `error` null, `data` is non-null.
    books = data;
  }
} else {
  loadError = "Supabase is not configured";
}

// Only asked when the default view comes back empty, to tell "nothing in progress" apart from
// "nothing at all" — the two need different sentences, and getting it wrong tells a reader
// with no books that all their books are finished.
let totalBooks = books.length;

if (supabase && !loadError && books.length === 0 && status !== "all") {
  const { count } = await supabase.from("books").select("id", { count: "exact", head: true });
  totalBooks = count ?? 0;
}

const dateFormatter = new Intl.DateTimeFormat("en-GB", { dateStyle: "medium" });
const formatDate = (iso: string) => dateFormatter.format(new Date(iso));

// The empty state has to answer the filter the reader is actually looking at. Under
// ?status=finished, "Add your first one above" would be wrong twice over: they may have
// plenty of books, and adding one would not put it in this view.
const emptyMessage =
  totalBooks === 0
    ? "No books yet. Add your first one above."
    : status === "finished"
      ? "No finished books yet. Open a book and mark it finished."
      : status === "active"
        ? "Nothing currently reading — every book in your collection is finished."
        : "No books yet. Add your first one above.";
---

<AppLayout title="Your books">
  <div class="pad">
    <h1 class="page-title">Your books</h1>
  </div>

  {
    /* Collapsed by default, for the same reason the cast's add-character form is:
      the reader opening this screen is far more often looking for a book than
      adding one, and an always-open two-field form owned the whole first screen
      of a phone. Adding still costs one tap.

      `open` when the server rejected a submission — otherwise the error would
      land inside a collapsed section. Server-rendered, so no JavaScript decides it. */
  }
  <details class="disclose block-disclose" open={formError !== null}>
    <summary>Add book</summary>
    <div class="disclose-body">
      <AddBookForm serverError={formError} client:load />
    </div>
  </details>

  {
    /* The filters ARE the section head. They were a separate band under a
      "Collection" label that said the same thing the active filter already
      says, which cost a whole strip of a phone screen to tell the reader
      twice. */
  }
  <div class="sec-head">
    <nav class="filters" aria-label="Filter by status">
      <a
        href="/books"
        class:list={["filter", "label", { on: status === "active" }]}
        aria-current={status === "active" ? "page" : undefined}>Reading</a
      >
      <a
        href="/books?status=finished"
        class:list={["filter", "label", { on: status === "finished" }]}
        aria-current={status === "finished" ? "page" : undefined}>Finished</a
      >
      <a
        href="/books?status=all"
        class:list={["filter", "label", { on: status === "all" }]}
        aria-current={status === "all" ? "page" : undefined}>All</a
      >
    </nav>
    <span class="label">{books.length}</span>
  </div>

  {loadError && <p class="error-text pad">{loadError}</p>}

  {!loadError && books.length === 0 && <p class="note-text empty">{emptyMessage}</p>}

  <ul class="list">
    {
      books.map((book) => (
        <Row
          href={`/books/${book.id}`}
          title={book.title}
          dim={book.finished_at !== null}
          note={book.author ?? "Author unknown"}
          stat={{ label: "Cast", value: castLabel(book.characters[0]?.count ?? 0) }}
          meta={[book.finished_at ? `Finished ${formatDate(book.finished_at)}` : null]}
          metaWide={[book.finished_at ? null : formatDate(book.created_at)]}
        />
      ))
    }
  </ul>
</AppLayout>

<style>
  .page-title {
    font-size: var(--text-lg);
    line-height: 1.15;
  }
  /* A phone already says "about-books" in the top bar and "COLLECTION" in the
     section head; a 23px title between them is the third time the reader is
     told where they are, and it costs a row of the list. */
  @media (max-width: 40rem) {
    .page-title {
      font-size: var(--text-md);
    }
  }

  /* A page-level disclosure reads as a band across the page, not as a row. */
  .block-disclose {
    border-block: var(--rule-w) solid var(--rule);
    margin-block: var(--space-xs);
    padding-inline: var(--space-md);
  }
  .block-disclose > summary {
    padding-block: var(--space-xs);
  }
  .block-disclose > .disclose-body {
    border-block-start: 0;
    padding-block-end: var(--space-md);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    min-width: 0;
  }
  .filter {
    text-decoration: none;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
  }
  @media (pointer: fine) {
    .filter {
      min-height: 0;
    }
  }
  .filter:hover {
    color: var(--ink);
  }
  /* Underline as well as colour, so the current filter survives a greyscale pass. */
  .filter.on {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  /* One sentence, not a panel. An empty library on a phone should not cost a
     screenful of centred box and icon. */
  .empty {
    padding: var(--space-md);
  }
</style>
