---
import Layout from "@/layouts/Layout.astro";
import AddBookForm from "@/components/books/AddBookForm";
import { createClient } from "@/lib/supabase";
import type { Book } from "@/types";
import { Library } from "lucide-react";

type BookRow = Pick<Book, "id" | "title" | "author" | "created_at" | "finished_at">;

const formError = Astro.url.searchParams.get("error");

// "Currently reading" is the default, because that is the shelf a reader opening the app is
// almost always looking at; the whole collection is one click away under "All". Anything
// unrecognised — including a nonsense value typed into the URL — falls back to that same
// default rather than an error page.
const STATUS_FILTERS = ["active", "finished", "all"] as const;
type StatusFilter = (typeof STATUS_FILTERS)[number];

const requestedStatus = Astro.url.searchParams.get("status");
const status: StatusFilter = STATUS_FILTERS.find((f) => f === requestedStatus) ?? "active";

const supabase = createClient(Astro.request.headers, Astro.cookies);

let books: BookRow[] = [];
let loadError: string | null = null;

if (supabase) {
  // RLS restricts this to the signed-in reader's own rows; no user_id filter is needed
  // here, and adding one would duplicate the policy rather than reinforce it.
  const base = supabase.from("books").select("id, title, author, created_at, finished_at");

  // finished_at IS the status: null means currently reading, a timestamp means finished.
  const scoped =
    status === "active"
      ? base.is("finished_at", null)
      : status === "finished"
        ? base.not("finished_at", "is", null)
        : base;

  const { data, error } = await scoped.order("created_at", { ascending: false });

  if (error) {
    loadError = error.message;
  } else {
    // Supabase's response is a discriminated union: with `error` null, `data` is non-null.
    books = data;
  }
} else {
  loadError = "Supabase is not configured";
}

// Only asked when the default view comes back empty, to tell "nothing in progress" apart from
// "nothing at all" — the two need different sentences, and getting it wrong tells a reader
// with no books that all their books are finished.
let totalBooks = books.length;

if (supabase && !loadError && books.length === 0 && status !== "all") {
  const { count } = await supabase.from("books").select("id", { count: "exact", head: true });
  totalBooks = count ?? 0;
}

const dateFormatter = new Intl.DateTimeFormat("en-GB", { dateStyle: "medium" });
const formatDate = (iso: string) => dateFormatter.format(new Date(iso));

const filterLinkClass = (isCurrent: boolean) =>
  isCurrent ? "text-white underline" : "text-purple-300 hover:underline";

// The empty state has to answer the filter the reader is actually looking at. Under
// ?status=finished, "Add your first one above" would be wrong twice over: they may have
// plenty of books, and adding one would not put it in this view.
const emptyMessage =
  totalBooks === 0
    ? "No books yet. Add your first one above."
    : status === "finished"
      ? "No finished books yet. Open a book and mark it finished."
      : status === "active"
        ? "Nothing currently reading — every book in your collection is finished."
        : "No books yet. Add your first one above.";
---

<Layout title="My books">
  <div class="bg-cosmic min-h-screen px-4 py-10">
    <div class="mx-auto w-full max-w-2xl space-y-8">
      <header class="text-center">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          My books
        </h1>
        <p class="mt-2 text-sm text-blue-100/60">Add a book, then build up its characters as you read.</p>
      </header>

      <section class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <h2 class="mb-4 text-lg font-semibold">Add a book</h2>
        <AddBookForm serverError={formError} client:load />
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-white">
          Your collection
          {books.length > 0 && <span class="text-blue-100/50">({books.length})</span>}
        </h2>

        <nav class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
          <a href="/books" class:list={filterLinkClass(status === "active")}>Currently reading</a>
          <a href="/books?status=finished" class:list={filterLinkClass(status === "finished")}>Finished</a>
          <a href="/books?status=all" class:list={filterLinkClass(status === "all")}>All</a>
        </nav>

        {
          loadError && (
            <p class="rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">{loadError}</p>
          )
        }

        {
          !loadError && books.length === 0 && (
            <div class="rounded-2xl border border-white/10 bg-white/5 p-8 text-center text-blue-100/60 backdrop-blur-xl">
              <Library className="mx-auto mb-3 size-8 text-white/30" />
              <p>{emptyMessage}</p>
            </div>
          )
        }

        <ul class="space-y-3">
          {
            books.map((book) => (
              <li class="rounded-2xl border border-white/10 bg-white/10 p-4 text-white backdrop-blur-xl">
                <a href={`/books/${book.id}`} class="font-medium break-words hover:underline">
                  {book.title}
                </a>
                <p class="mt-1 text-sm break-words text-blue-100/70">{book.author ?? "Author unknown"}</p>
                <p class="mt-2 text-xs text-blue-100/40">
                  {book.finished_at ? `Finished ${formatDate(book.finished_at)}` : "Currently reading"}
                  <span class="text-blue-100/30"> &middot; added {formatDate(book.created_at)}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</Layout>
